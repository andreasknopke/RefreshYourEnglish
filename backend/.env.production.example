# Backend Environment Variables (für Railway)

# Server Configuration
PORT=3001
NODE_ENV=production

# Security
JWT_SECRET=ERSETZE-DIES-MIT-EINEM-SICHEREN-ZUFÄLLIGEN-STRING-MIN-32-ZEICHEN

# CORS - Frontend URL (wird nach Deployment gesetzt)
CORS_ORIGIN=https://deine-frontend-url.railway.app

# Database
DB_PATH=/app/data/vocabulary.db

# LLM: frei konfigurierbare OpenAI-kompatible Schnittstelle
# Base URL, API-Key und Modellname – Mistral, OpenAI oder lokales Modell (Ollama/vLLM).
# Beispiele Base URL: https://api.mistral.ai/v1, https://api.openai.com/v1,
#                     http://localhost:11434/v1 (Ollama), http://localhost:8000/v1 (vLLM)
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=dein-api-key-hier
LLM_MODEL=mistral-large-latest
