# Environment Variablen für LLM-Integration

# Backend API URL
VITE_API_URL=http://localhost:3001/api

# LLM: frei konfigurierbare OpenAI-kompatible Schnittstelle
# Base URL, API-Key und Modellname – damit laufen Mistral, OpenAI,
# aber auch lokale Modelle (Ollama, vLLM, LM Studio).
#
# Beispiele Base URL:
#   https://api.mistral.ai/v1
#   https://api.openai.com/v1
#   http://localhost:11434/v1     (Ollama)
#   http://localhost:8000/v1      (vLLM)
VITE_LLM_BASE_URL=https://api.mistral.ai/v1
VITE_LLM_API_KEY=your_llm_api_key_here
VITE_LLM_MODEL=mistral-large-latest

# Hinweis: Speech-to-Text und Text-to-Speech laufen ausschließlich über die
# Browser Web Speech API und benötigen keine Konfiguration.
