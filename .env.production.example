# Frontend Environment Variables (für Railway/Vercel)

# Backend API URL (wird nach Backend-Deployment gesetzt)
VITE_API_URL=https://dein-backend-url.railway.app/api

# LLM (OpenAI-kompatible Schnittstelle): Base URL, API-Key und Modell
VITE_LLM_BASE_URL=https://api.mistral.ai/v1
VITE_LLM_API_KEY=dein-api-key-hier
VITE_LLM_MODEL=mistral-large-latest
